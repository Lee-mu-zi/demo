<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.leemuzi.mybatis.mapper.CourseMapper">

    <resultMap id="CourseAndTeacherMap" type="com.leemuzi.mybatis.dto.CourseAndTeacherDTO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="credit" column="credit"/>
        <result property="hours" column="hours"/>
        <result property="description" column="description"/>
        <association property="teacher" javaType="com.leemuzi.mybatis.domain.Teacher">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="gender" column="gender"/>
            <result property="age" column="age"/>
            <result property="title" column="title"/>
            <result property="department" column="department"/>
            <result property="email" column="email"/>
            <result property="phone" column="phone"/>
            <result property="hireDate" column="hire_date"/>
        </association>
    </resultMap>
    <select id="selectCourseAndTeacherById" resultMap="CourseAndTeacherMap">
        select *
        from course c
                 left join teacher t on c.teacher_id = t.id
        where c.id = #{id}
    </select>
</mapper>